{
  "name": "@doqs/analog",
  "version": "0.11.0",
  "description": "Composable Markdown documentation UI for Analog.js",
  "license": "MIT",
  "author": "Andersseen (https://github.com/Andersseen)",
  "homepage": "https://github.com/Andersseen/doqs#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Andersseen/doqs.git", "directory": "packages/doq" },
  "bugs": { "url": "https://github.com/Andersseen/doqs/issues" },
  "keywords": ["angular", "analog", "analogjs", "documentation", "markdown", "docs", "ssr", "ssg"],
  "type": "module",
  "engines": { "node": "^20.19.0 || ^22.12.0 || >=24.0.0" },
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@analogjs/content": "^2.9.2",
    "@angular/common": "^21.2.2 || ^22.0.0",
    "@angular/core": "^21.2.2 || ^22.0.0",
    "@angular/platform-browser": "^21.2.2 || ^22.0.0",
    "@angular/router": "^21.2.2 || ^22.0.0",
    "rxjs": "^7.8.0",
    "pagefind": "^1.5.0",
    "typescript": "^5.5.0 || ^6.0.0"
  },
  "peerDependenciesMeta": { "pagefind": { "optional": true }, "typescript": { "optional": true } },
  "dependencies": { "tslib": "^2.3.0" },
  "sideEffects": ["./styles.css"],
  "module": "./dist/fesm2022/doqs-analog.mjs",
  "typings": "./dist/types/doqs-analog.d.ts",
  "bin": { "doq": "./bin/doq.mjs", "doq-search": "./bin/doq-search.mjs", "doq-api": "./bin/doq-api.mjs" },
  "files": ["fesm2022", "types", "bin", "styles.css", "README.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/types/doqs-analog.d.ts", "default": "./dist/fesm2022/doqs-analog.mjs" },
    "./search-index": { "types": "./bin/search-index.d.mts", "default": "./bin/search-index.mjs" },
    "./vite": { "types": "./bin/vite.d.mts", "default": "./bin/vite.mjs" },
    "./api-reference": { "types": "./bin/api-reference.d.mts", "default": "./bin/api-reference.mjs" },
    "./content": { "types": "./bin/content.d.mts", "default": "./bin/content.mjs" },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "pack": "pnpm build && cd dist && pnpm pack --pack-destination ../../../artifacts",
    "test:components": "vitest run -c vitest.components.config.ts"
  },
  "devDependencies": {
    "@analogjs/content": "^2.9.2",
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@angular/common": "^21.2.2",
    "@angular/compiler": "^21.2.2",
    "@angular/compiler-cli": "^21.2.2",
    "@angular/core": "^21.2.2",
    "@angular/platform-browser": "^21.2.2",
    "@angular/router": "^21.2.2",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^27.4.0",
    "marked": "15.0.12",
    "marked-gfm-heading-id": "4.1.4",
    "pagefind": "1.5.2",
    "ng-packagr": "^21.2.2",
    "rxjs": "^7.8.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
