{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "content": "doq content generate --dir ../.. --config apps/site/doq.content.json",
    "content:check": "doq content check --dir ../.. --config apps/site/doq.content.json",
    "api": "doq-api generate --cwd ../.. --entry packages/doq/bin/content.d.mts --content-dir apps/site/src/content/docs --out apps/site/src/content/docs/reference/content-api --base-path /docs --group \"Content tooling API\" --title \"Content tooling API\" --order-start 2000 --strict",
    "api:check": "doq-api check --cwd ../.. --entry packages/doq/bin/content.d.mts --content-dir apps/site/src/content/docs --out apps/site/src/content/docs/reference/content-api --base-path /docs --group \"Content tooling API\" --title \"Content tooling API\" --order-start 2000 --strict",
    "dev": "vite",
    "build": "vite build && doq-search index dist/analog/public",
    "preview": "node ../../scripts/preview-static.ts dist/analog/public",
    "test:components": "vitest run -c vitest.components.config.ts",
    "deploy": "wrangler pages deploy"
  },
  "dependencies": {
    "@analogjs/content": "^2.9.0",
    "@analogjs/router": "^2.9.0",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.2",
    "@angular/compiler": "^21.2.2",
    "@angular/core": "^21.2.2",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.2",
    "@angular/platform-server": "^21.2.2",
    "@angular/router": "^21.2.2",
    "@doqs/analog": "workspace:*",
    "@voltui/components": "^1.3.3",
    "angular-movement": "^1.2.0",
    "front-matter": "^4.0.2",
    "h3": "^1.13.0",
    "lumen-icons": "^0.2.0",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "ng-primitives": "^0.131.2",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.9.0",
    "@analogjs/vite-plugin-angular": "^2.9.0",
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^27.4.0",
    "pagefind": "1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.1.12",
    "wrangler": "4.151.3"
  }
}
